# Xbox sign-in. Register an app at https://portal.azure.com (App registrations):
#   Supported account types: Personal Microsoft accounts only
#   Redirect URI (Web):      http://localhost:3000/api/auth/callback
# then create a client secret under Certificates & secrets. Restart the dev server after saving.
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
# Random string, 32+ characters. Encrypts the session cookies.
SESSION_SECRET=
# Optional. Set when the app runs behind a proxy or on a deployed domain; must match the Azure redirect URI.
XBOX_REDIRECT_URI=
